[Unit]
Description=Demo web app, hardened
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/app/app.py
User=appuser
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
MemoryMax=1G

[Install]
WantedBy=multi-user.target
